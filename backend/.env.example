## Django basics ##
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=theyashgupta.com,www.theyashgupta.com,api.theyashgupta.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://theyashgupta.com,https://www.theyashgupta.com,https://api.theyashgupta.com

## Production site identity (used in sitemap.xml + canonical URLs) ##
SITE_BASE_URL=https://theyashgupta.com
SITE_DOMAIN=theyashgupta.com

## Database (Fly.io persistent volume mount; leave default for local dev) ##
DATABASE_PATH=/data/db.sqlite3

## Email — Resend free tier (3,000 emails / month) ##
# 1. Sign up at https://resend.com → Create API key
# 2. Add theyashgupta.com under "Domains" → copy the SPF/DKIM DNS records to your registrar
# 3. Set the variables below
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEFAULT_FROM_EMAIL=Yash Gupta <yash@theyashgupta.com>
LEAD_NOTIFICATION_EMAIL=yash@theyashgupta.com

## Admin auto-create (optional — runs in start.sh on every deploy) ##
# Leave blank to skip. If set, the user is created (or its password reset) on each boot.
DJANGO_ADMIN_USERNAME=
DJANGO_ADMIN_EMAIL=
DJANGO_ADMIN_PASSWORD=
